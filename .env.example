# ── Web app (Next.js — Vercel or `bun run dev`) ─────────────────────────────
# Postgres. Local dev: `docker compose up -d` provides this instance.
DATABASE_URL=postgres://monecraft:monecraft@localhost:5432/monecraft

# better-auth: a long random secret (e.g. `openssl rand -base64 32`) and the
# app's own origin.
BETTER_AUTH_SECRET=change-me-to-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Shared HS256 secret for game-server join tickets. Must be IDENTICAL on the
# web app (mints) and the game server (verifies).
GAME_TICKET_SECRET=change-me-too-shared-with-game-server

# Where the browser connects for realtime play (the Fly app in production).
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:8080

# ── Game server (server/ — Fly.io or `bun server/index.ts`) ─────────────────
# Reuses DATABASE_URL and GAME_TICKET_SECRET above, plus:
# PORT=8080
# PERSISTENCE=postgres        # or "memory" for DB-less local iteration / e2e
# ADMIN_TOKEN=change-me       # guards /rooms diagnostics
